[Unit]
Description=Kovanica Testnet Faucet Service
Documentation=https://github.com/KovanicaDAG/kovanica-l1
After=network-online.target kovanica-node.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=kovanica
Group=kovanica
UMask=0027
WorkingDirectory=/var/lib/kovanica
StateDirectory=kovanica
ConfigurationDirectory=kovanica

# Load environment configuration overrides (faucet keystore, RPC write token, trusted proxies)
EnvironmentFile=-/etc/kovanica/kovanica-faucet.env

ExecStart=/usr/local/bin/kovanica-faucet

Restart=on-failure
RestartSec=10
LimitNOFILE=16384

# Resource budget conforming to 2-4 GB VPS footprint
MemoryMax=512M
MemoryAccounting=yes

# Sandboxing and security hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kovanica
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
